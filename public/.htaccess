# Codux Studio — Apache config for the Next.js static export (out/)
Options -MultiViews -Indexes
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# Force HTTPS + non-www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://coduxstudio.com%{REQUEST_URI} [R=301,L]

# Retired portfolio items -> portfolio overview (keeps indexed links from 404-ing)
RewriteRule ^(sr/)?portfolio/alfa-higijena/?$ /$1portfolio [R=301,L]

# Remove trailing slash (except root) to keep URLs consistent with canonical tags
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^ /%1 [R=301,L]

# /index.html -> /   and   /about.html -> /about
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve real files directly (assets, _next/*, *.txt RSC payloads, sitemap.xml ...)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Clean URLs: /about -> about.html, /sr -> sr.html, /sr/portfolio/x -> sr/portfolio/x.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [L]

# Anything else falls through to ErrorDocument 404 (/404.html, real 404 status)

<IfModule mod_headers.c>
  # hashed build assets never change
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
